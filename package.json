{
  "name": "technomiles-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && node scripts/mariadb-compat.mjs",
    "db:migrate": "drizzle-kit migrate",
    "create-user": "tsx scripts/create-user.ts",
    "seed-clients": "tsx scripts/seed-clients.ts",
    "demo": "tsx scripts/demo-data.ts",
    "seed-company": "tsx scripts/seed-company.ts",
    "build:hostinger": "drizzle-kit migrate && tsx scripts/seed-clients.ts && tsx scripts/seed-company.ts && next build --webpack"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "mysql2": "^3.24.4",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
